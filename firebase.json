{
  "hosting": {
    "public": "build",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/interventions/",
        "destination": "/interventions",
        "type": 301
      },
      {
        "source": "/michelle/",
        "destination": "/team/michelle-charbonnier",
        "type": 301
      },
      {
        "source": "/michelle",
        "destination": "/team/michelle-charbonnier",
        "type": 301
      },
      {
        "source": "/booking",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/suboxone-treatment",
        "destination": "/psychiatry",
        "type": 301
      },
      {
        "source": "/alcohol-treatment",
        "destination": "/psychiatry",
        "type": 301
      },
      {
        "source": "/mat",
        "destination": "/psychiatry",
        "type": 301
      },
      {
        "source": "/addiction",
        "destination": "/conditions",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|gif|webp|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
